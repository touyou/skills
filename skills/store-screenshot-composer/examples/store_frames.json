{
  "locales": ["ja", "en"],
  "style": {
    "theme": "light",
    "align": "left",
    "caption_height": 0.27,
    "title_size": 0.088,
    "eyebrow": { "icon": "IntentTodoWatchApp/Assets.xcassets/AppIcon.appiconset/AppIcon.png", "name": "Intento" }
  },
  "sets": [
    {
      "name": "iphone",
      "preset": "iphone-6.9",
      "input": "Screenshots/iphone/{locale}",
      "output": "StoreImages/iphone/{locale}",
      "shots": [
        {
          "file": "01-list.png",
          "title": { "ja": "話しかけるだけで、\nやることが片づく。", "en": "Just say it.\nIt's on your list." },
          "subtitle": { "ja": "Siri・ウィジェット・コントロールセンターから", "en": "From Siri, widgets and Control Center" },
          "style": {
            "device_x": 0.56,
            "device_width": 0.78,
            "callout": {
              "box": [0.0, 0.18, 1.0, 0.12],
              "width": 0.66,
              "x": 0.34,
              "y": 0.8,
              "tilt": -3,
              "corner_radius": 0.06
            }
          }
        },
        {
          "file": "02-detail.png",
          "title": { "ja": "期限もメモも、\nひと目で。", "en": "Due dates and notes,\nat a glance." },
          "style": { "device_x": 0.98, "tilt": -7 }
        },
        {
          "file": "03-add.png",
          "title": { "ja": "思いついたら、\nすぐ追加。", "en": "Add it the moment\nit comes to mind." },
          "style": { "device_x": 0.63, "device_width": 0.64, "tilt": 3, "device_offset": 0.05 }
        },
        {
          "file": "04-settings.png",
          "title": { "ja": "25 のアクションで、\nショートカットに。", "en": "25 actions,\nready for Shortcuts." },
          "subtitle": { "ja": "ほかのアプリと組み合わせて自動化", "en": "Automate with any other app" },
          "style": { "tilt": 4, "device_x": 0.52 }
        },
        {
          "file": "05-lists.png",
          "title": { "ja": "リストとタグで、\nすっきり整理。", "en": "Lists and tags\nkeep it tidy." },
          "style": { "device_width": 0.9, "device_offset": 0.06 }
        }
